{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "lottery": {
      ".read": true,
      ".write": "auth != null"
    },
    "webrtc_broadcasters": {
      "$broadcasterId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $broadcasterId"
      }
    },
    "stream_viewers": {
      "$streamId": {
        ".read": true,
        ".write": "auth != null"
      }
    }
  }
}
