rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole(role) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == role;
    }
    function isAdmin() {
      return hasRole('SUPER_ADMIN') || 
             hasRole('TOURNAMENT_ADMIN') || 
             hasRole('MATCH_ADMIN') || 
             hasRole('CONTENT_ADMIN') || 
             hasRole('MODERATOR');
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/notifications/{notifId} {
      allow read: if isOwner(userId);
      allow create: if isAdmin() || isOwner(userId);
      allow update, delete: if isOwner(userId);
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tournaments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seasons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registrations/{id} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == id;
      allow update, delete: if isAdmin() || isOwner(id);
    }

    match /payments/{id} {
      allow read: if isAdmin() || isOwner(id);
      allow create: if isAuthenticated() && request.auth.uid == id;
      allow update, delete: if isAdmin();
    }

    match /clubs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clubPools/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lotteries/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fixtures/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /matches/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /leagueTables/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /playerStats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /friendlyMatches/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /achievements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /playerAchievements/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /awards/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /reports/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /galleryPhotos/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /feedPosts/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || resource.data.authorUid == request.auth.uid;
    }

    match /feedPosts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /drawConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /challenges/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /drawComments/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /liveStreams/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isOwner(resource.data.streamerUid);
    }

    match /liveTvChat/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /matchResults/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
